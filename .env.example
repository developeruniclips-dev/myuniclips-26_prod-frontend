# P2-J/J1: public documentation with synthetic placeholders only.
# Never copy live credentials here; local .env variants must remain untracked.
# Frontend Environment Variables

# API URL for backend (change for production)
VITE_API_URL=http://localhost:3001/api
# Production: VITE_API_URL=https://your-backend.onrender.com/api

# Stripe Publishable Key (safe to expose in frontend)
VITE_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here

# VITE_* values enter the browser bundle. Never add server/provider secrets.
